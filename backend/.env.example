APP_ENV=development
APP_NAME=DigitalLife API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://digitallife_user:replace-me@localhost:5432/digitallife
TEST_DATABASE_URL=postgresql+psycopg://digitallife_user:replace-me@localhost:5432/digitallife_test
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OPENAI_API_KEY=replace-with-your-server-side-key
OPENAI_MODEL=replace-with-model-name
OPENAI_BASE_URL=
LLM_API_MODE=responses
LLM_JSON_MODE_ENABLED=true
LLM_STRUCTURED_OUTPUT_ENABLED=true
LLM_TIMEOUT_SECONDS=30
LLM_HISTORY_LIMIT=20
